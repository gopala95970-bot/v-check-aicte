# Copy to .env and edit. Never commit .env. No secret is ever hard-coded in source.

# --- OCR (needed for scanned PDFs and images) -----------------------------
# Leave blank if `tesseract` is on your PATH. On Windows, set the full path, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- API server -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Browser origins allowed to call the API (the React dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Secrets: leave JWT_SECRET blank to auto-generate one into storage/.jwt_secret
# (never committed). To set your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOKEN_TTL_MINUTES=480

# --- Storage (outside any public/static directory) -------------------------
STORAGE_DIR=./storage
# Optional overrides:  UPLOAD_DIR=./storage/uploads   DATABASE_URL=sqlite:///./storage/vcheck.db
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=50

# --- Demo data --------------------------------------------------------------
# 1 = on first start create the six synthetic scenario applications (real pipeline). 0 = empty system.
SEED_DEMO=1
# Pin "today" for reproducible date rules in a live demo (YYYY-MM-DD). Blank = real date.
VCHECK_TODAY=

# --- Verification ------------------------------------------------------------
# Default source: off | simulation | unavailable.  Simulation = local SYNTHETIC registry, always labelled,
# never reported as "verified". Administrators can change this in Settings.
VERIFICATION_MODE=off

# --- Optional AI assistance (the core works with NONE of these) ------------
ANTHROPIC_API_KEY=
